local function ResetBypass()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Dead) end
        char:ClearAllChildren()
        local newChar = Instance.new("Model")
        newChar.Parent = workspace
        LocalPlayer.Character = newChar
        task.wait()
        LocalPlayer.Character = char
        newChar:Destroy()
    end
end

local GRAB_HOLD_DURATION = 0.232
local InternalStealCache = {}

local function buildStealCallbacks(prompt)
    if InternalStealCache[prompt] then return end
    local data = { holdCallbacks = {}, triggerCallbacks = {}, ready = true }
    local ok1, conns1 = pcall(getconnections, prompt.PromptButtonHoldBegan)
    if ok1 and type(conns1) == "table" then
        for _, conn in ipairs(conns1) do
            if type(conn.Function) == "function" then
                table.insert(data.holdCallbacks, conn.Function)
            end
        end
    end
    local ok2, conns2 = pcall(getconnections, prompt.Triggered)
    if ok2 and type(conns2) == "table" then
        for _, conn in ipairs(conns2) do
            if type(conn.Function) == "function" then
                table.insert(data.triggerCallbacks, conn.Function)
            end
        end
    end
    if #data.holdCallbacks > 0 or #data.triggerCallbacks > 0 then
        InternalStealCache[prompt] = data
    end
end

local function findBestPodiumForTarget(targetPart)
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil, nil end
    local bestSpawn, bestPrompt, bestDist = nil, nil, math.huge
    for _, plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        if not (sign and sign:FindFirstChild("YourBase") and sign.YourBase.Enabled) then
            local podiums = plot:FindFirstChild("AnimalPodiums")
            if podiums then
                for _, podium in ipairs(podiums:GetChildren()) do
                    local base = podium:FindFirstChild("Base")
                    if base then
                        local spawn = base:FindFirstChild("Spawn")
                        local attach = spawn and spawn:FindFirstChild("PromptAttachment")
                        if attach then
                            local pObj = attach:FindFirstChildOfClass("ProximityPrompt")
                            if pObj and (pObj.ActionText:find("Steal") or pObj.ObjectText:find("Steal")) then
                                local d = (spawn.Position - targetPart.Position).Magnitude
                                if d < bestDist then
                                    bestDist = d; bestSpawn = spawn; bestPrompt = pObj
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestSpawn, bestPrompt
end

local function findBestBrainrot()
    local df = workspace:FindFirstChild("Debris")
    if not df then return nil end
    local best, bestVal = nil, -math.huge
    for _, obj in ipairs(df:GetChildren()) do
        if obj:IsA("BasePart") and obj.Position.Y <= 10 then
            local dnl, gl
            for _, child in ipairs(obj:GetChildren()) do
                if child:IsA("BillboardGui") or child:IsA("SurfaceGui") then
                    for _, label in ipairs(child:GetChildren()) do
                        if label:IsA("TextLabel") then
                            if label.Name == "DisplayName" then dnl = label
                            elseif label.Name == "Generation" then gl = label end
                        end
                    end
                end
            end
            if dnl then
                local gen = gl and gl.Text or "0"
                local num = tonumber(gen:match("[%d%.]+")) or 0
                if gen:find("k") then num = num * 1e3 elseif gen:find("m") then num = num * 1e6
                elseif gen:find("b") then num = num * 1e9 elseif gen:find("t") then num = num * 1e12 end
                if num > bestVal then bestVal = num; best = obj end
            end
        end
    end
    return best
end

